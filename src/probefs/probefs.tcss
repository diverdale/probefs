/* Superfile-style cockpit: each region is its own rounded box, no outer frame.
   The active (current) pane's border is accent-colored; titles sit in the
   top border edge via each widget's border_title. */

#cockpit {
    height: 1fr;
}

#header-bar {
    height: 3;  /* 1 content row + 2 border rows (Textual uses border-box sizing) */
    border: round $panel-lighten-1;
}

#panes {
    layout: horizontal;
    height: 1fr;
}
#pane-parent {
    width: 1fr;
    height: 100%;
    border: round $panel-lighten-1;
    border-title-align: left;
}
#pane-current {
    width: 1fr;
    height: 100%;
    border: round $accent;
    border-title-align: left;
}
#pane-preview {
    width: 2fr;
    height: 100%;
    border: round $panel-lighten-1;
    border-title-align: left;
}

DirectoryList DataTable {
    background: $panel;
}

/* The current pane is the active one: its cursor is bright. The parent pane's
   cursor is subdued — it only marks "the directory you're in" for context, so
   it shouldn't compete with the active pane's selection. */
#pane-current DataTable > .datatable--cursor {
    background: $accent 40%;
    color: $text;
}
#pane-parent DataTable > .datatable--cursor {
    background: $panel-lighten-1;
    color: $text-muted;
}

#status-bar {
    height: 4;  /* 2 content rows + 2 border rows */
    border: round $panel-lighten-1;
}
